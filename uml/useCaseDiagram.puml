@startuml
!pragma layout smetana
title Spring Boot Backend — Use Case Diagram\n(simplified from Java controllers)

skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName SansSerif
skinparam usecase {
  BackgroundColor #FEFEFE
  BorderColor #333333
}
skinparam actor {
  BackgroundColor #FEFEFE
  BorderColor #333333
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #555555
}

left to right direction

actor "Guest" as Guest
actor "User\n(ROLE_USER)" as User
actor "Admin\n(ROLE_ADMIN)" as Admin

Admin --|> User

rectangle "Spring Boot Application" {
  usecase "Register / Login\n(incl. OAuth)" as UC_Auth
  usecase "Reset Password" as UC_Password

  usecase "Manage Profile" as UC_Profile
  usecase "Shop &\nPlace Orders" as UC_Shop
  usecase "Send Email &\nChat" as UC_Comm
  usecase "Use Integrations\n(Drive / Gemini)" as UC_Integrations
  usecase "Manage Employees" as UC_Employees

  usecase "Administer System" as UC_Admin
}

Guest --> UC_Auth
Guest --> UC_Password

User --> UC_Profile
User --> UC_Shop
User --> UC_Comm
User --> UC_Integrations
User --> UC_Employees

Admin --> UC_Admin

note right of UC_Admin
  Stock, users, roles,
  email templates, logs,
  registration settings,
  all chat groups
end note

note right of UC_Shop
  Catalog, cart, checkout,
  addresses, payments
end note

@enduml

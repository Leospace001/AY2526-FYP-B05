# Copy to .env in project root for docker compose
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional: route Gemini outbound traffic through an HTTP proxy (US/EU)
# GEMINI_PROXY_HOST=your-proxy-host
# GEMINI_PROXY_PORT=8080

# OAuth social login (optional — leave blank to disable a provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
